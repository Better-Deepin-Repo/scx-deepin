Description: Prune workspace members that are not built or shipped
 The Debian package ships the 18 schedulers, scx_characterize and scxtop.
 xtask and vmlinux_docify are upstream development helpers; scx_forge_agent
 and scx_mitosis drag in the reqwest/gix/ktstr stack (openssl-sys,
 aws-lc-sys + cmake) that we do not want as build dependencies.  Pruning
 them at Cargo.toml level (rather than via `cargo build --workspace
 --exclude ...`) also keeps the vendored crate closure built by
 debian/make-vendor.sh minimal and identical to the built graph.
Author: LFRon <ronforever@outlook.com>
Forward-Status: not-needed
Last-Update: 2026-09-20

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -18,7 +18,6 @@
     "scheds/rust/scx_flash",
     "scheds/rust/scx_lavd",
     "scheds/rust/scx_layered",
-    "scheds/rust/scx_mitosis",
     "scheds/rust/scx_p2dq",
     "scheds/rust/scx_pandemonium",
     "scheds/rust/scx_rustland",
@@ -29,9 +28,6 @@
     "scheds/experimental/scx_mlfq",
     "tools/scx_characterize",
     "tools/scxtop",
-    "tools/scx_forge_agent",
-    "tools/vmlinux_docify",
-    "tools/xtask",
 ]
 resolver = "2"
 
